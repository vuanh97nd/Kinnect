# Future cloud API host. Do NOT replace current production sfu.env with this template.
# DB configuration is separate cloud-db.env; current backend is not cloud-ready yet.
KINNECT_LIVE_TRANSPORT=sfu
KINNECT_SFU_MANAGED=remote
KINNECT_SFU_URL=wss://YOUR_PRIVATE_SFU_CONTROL_HOST/control
KINNECT_SFU_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
KINNECT_LIVE_MAX_VIEWERS=2000
KINNECT_LIVE_MAX_ROOMS=30
# PC TURN: use short-lived credentials once the TURN issuer is implemented.
# Never use the HuggingFace provider if all relay traffic must stay on the PC.
KINNECT_TURN_PROVIDER=pc
TURN_URL=turn:YOUR_PC_TURN_HOST:3478?transport=udp,turns:YOUR_PC_TURN_HOST:5349?transport=tcp
TURN_USERNAME=REPLACE_WITH_PC_TURN_USER
TURN_CREDENTIAL=REPLACE_WITH_PC_TURN_CREDENTIAL
# Separate authorized file service: these two options are planning-only today.
KINNECT_MEDIA_ORIGIN=https://YOUR_PC_MEDIA_HOST
KINNECT_MEDIA_TIMEOUT_MS=5000
