# SFU runs on PC; control only behind authenticated TLS/private transport.
KINNECT_SFU_LISTEN=127.0.0.1:7885
KINNECT_SFU_UDP_PORT=7886
KINNECT_SFU_SECRET=REPLACE_WITH_SAME_CLOUD_CONTROL_SECRET
# Public IP / reachable UDP mapping must be configured for this actual network.
# KINNECT_SFU_PUBLIC_IPS=YOUR_PUBLIC_IPV4
# TURN installation, credential issuer and dedicated media service still required.
# Cloudflare HTTP Tunnel alone does not expose SFU/TURN UDP media ports.
