			<string>app.kinnect.live</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kinnect</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Kinnect cần quyền truy cập Camera để gọi video, phát trực tiếp (Livestream) và chụp ảnh/quay video đăng bài.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kinnect cần quyền truy cập Micro để truyền âm thanh trong cuộc gọi thoại, video call và livestream.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
