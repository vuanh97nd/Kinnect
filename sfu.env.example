# Copy to sfu.env. Keep this file server-only; never include the real secret in an APK.
KINNECT_LIVE_TRANSPORT=sfu
KINNECT_SFU_URL=ws://127.0.0.1:7885/control
KINNECT_SFU_LISTEN=127.0.0.1:7885
KINNECT_SFU_UDP_PORT=7886
KINNECT_SFU_SECRET=replace-with-at-least-32-random-characters
# Admission limits, not a measured capacity promise.
KINNECT_LIVE_MAX_VIEWERS=2000
KINNECT_LIVE_MAX_ROOMS=30
# On a dedicated VPS, set its public IPv4 address when required by NAT.
# KINNECT_SFU_PUBLIC_IPS=203.0.113.10
