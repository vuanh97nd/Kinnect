# Preparation only. The current SQLite server does NOT load this file.
# Copy to cloud-db.env on the server, never include it in an APK or public ZIP.
KINNECT_DATABASE_PROVIDER=postgres
KINNECT_DATABASE_URL=postgresql://kinnect_app:CHANGE_ME@YOUR_HOST:5432/kinnect?sslmode=verify-full
KINNECT_DATABASE_CA_FILE=
KINNECT_DATABASE_POOL_MAX=10
KINNECT_DATABASE_CONNECT_TIMEOUT_MS=10000
KINNECT_MEDIA_PROVIDER=local
