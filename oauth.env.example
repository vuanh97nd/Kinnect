# Khóa đăng nhập bằng Google và Facebook cho Kinnect.
# Sao chép file này thành oauth.env (cùng thư mục), điền khóa, KHÔNG commit oauth.env.
# Sau khi sửa: chạy stop-kinnect.cmd rồi start-kinnect-hidden.vbs. Thiếu khóa nào thì nút đó tự ẩn.
# Hướng dẫn tạo khóa từng bước: docs/dang-nhap-google-facebook.md

PUBLIC_URL=https://app.kinnect.io.vn

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers → My Apps → App settings → Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
